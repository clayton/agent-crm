{
  "name": "agent-crm-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "types": "wrangler types --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run types && tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  }
}
